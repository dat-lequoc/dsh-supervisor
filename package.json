{
  "name": "dsh-supervisor",
  "version": "0.7.0",
  "description": "Always-on supervisor agent for DeepSeek Harness: the main-agent preset plus the schedule overlay, installable as one dsh bundle",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./spawn": "./lib/spawn.js",
    "./control": "./lib/control.js",
    "./goal": "./lib/goal.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "agent-presets",
    "agi-template"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "supervisor",
    "subagent",
    "agent"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-goal": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-schedule": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-subagent": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.0"
  }
}
